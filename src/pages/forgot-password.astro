---
import Layout from '../layouts/Layout.astro';
import { ForgotPasswordForm } from '../components/auth/AuthForms';
import { Toaster } from 'sonner';
---

<Layout title="Forgot Password — Carouseln">
  <div class="min-h-screen flex items-center justify-center px-4 py-12 relative overflow-hidden bg-[var(--color-green)]">
    <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjAiIGhlaWdodD0iMjAiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+PGNpcmNsZSBjeD0iMiIgY3k9IjIiIHI9IjIiIGZpbGw9IiMwMDAiIGZpbGwtb3BhY2l0eT0iMC4xIi8+PC9zdmc+')] opacity-50" />
    <div class="relative z-10 w-full">
      <ForgotPasswordForm client:load />
    </div>
  </div>
  <Toaster client:load theme="light" position="top-right" />
</Layout>
