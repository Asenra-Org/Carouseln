# ──────────────────────────────────────────────────────────────────
# Carouseln — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit your actual .env file to version control.
# ──────────────────────────────────────────────────────────────────

# ── Firebase Client SDK (Safe for client exposure — secured by Firestore Rules)
# Get these from: Firebase Console → Project Settings → Your Apps
PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
PUBLIC_FIREBASE_APP_ID=YOUR_APP_ID
PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Server-Side Secrets (NEVER prefix with PUBLIC_ — stays server only)
# Get this from: Google AI Studio → API Keys
# Docs: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
